# No credentials needed for npm run demo. All payments/events are explicitly simulated.
TASK_PAYMENT_MODE=simulation
TASK_GITHUB_MODE=fixture
HOST=127.0.0.1
PORT=8787
DATA_DIR=data

# Live GitHub + simulated payments: set TASK_GITHUB_MODE=live.
# Reuse the already-authorized local gh CLI without copying its credential into a file:
# GITHUB_USE_CLI=1
# Or supply GITHUB_TOKEN through your environment (read-only repo access).
# For a GitHub App installation, use these instead of CLI/PAT:
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/app-private-key.pem
# GITHUB_WEBHOOK_SECRET=

# Required when HOST exposes the server beyond localhost; this protects task creation.
# TASK_ADMIN_TOKEN=

# Repository and maintainer inspected by the /tasks setup check (npm run tasks:setup).
# TASK_SETUP_REPOSITORY=OWNER/REPOSITORY
# TASK_SETUP_CLIENT=OWNER

# Contract WASM read by the operator deploy/upgrade scripts. Defaults are relative to
# apps/server and point into contracts/<crate>/target.
# ESCROW_WASM=../../contracts/escrow/target/wasm32-unknown-unknown/release/nearportal_escrow.wasm
# USDC_ESCROW_WASM=../../contracts/usdc-escrow/target/wasm32-unknown-unknown/release/nearportal_crypto_escrow.wasm
# USDC_ESCROW_REVIEWED_WASM=../../contracts/usdc-escrow/target/deadline-reviewed.wasm

# Optional: full payment-sandbox run. Requires the updated contract to be deployed.
# TASK_PAYMENT_MODE=sandbox
# TASK_GITHUB_MODE=live
# NEAR_NETWORK=testnet
# ESCROW_CONTRACT_ID=escrow.nearportal-test.testnet
# ARTISAN_ACCOUNT_ID=nearportal-test.testnet
# CLIENT_ACCOUNT_ID=client.nearportal-test.testnet
# MEDIATOR_ACCOUNT_ID=mediator.nearportal-test.testnet
# RELAYER_ACCOUNT_ID=nearportal-test.testnet
# GITHUB_VERIFIER_ACCOUNT_ID=verifier.nearportal-test.testnet
# NEAR_CREDENTIALS_DIR=data/sandbox/keys
# TASK_CLIENT_IBAN=<sandbox refund IBAN>
# ARTISAN_IBAN=<sandbox developer payout IBAN>
# MONERIUM_CLIENT_ID=
# MONERIUM_CLIENT_SECRET=
# MONERIUM_API=https://api.monerium.dev
# MONERIUM_CHAIN=basesepolia
# Demo NEAR keys are read from ~/.near-credentials/testnet/<account>.json.

# Optional exact provider-issued fictional payout IBANs that fail standard validation.
# Honored only in TASK_PAYMENT_MODE=sandbox; comma-separated.
TASK_SANDBOX_PAYOUT_IBANS=

# NearPortal website / real GitHub OAuth (never paste secrets into source files).
APP_ORIGIN=http://127.0.0.1:8787
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Callback: <APP_ORIGIN>/auth/github/callback
# Explicit localhost-only preview of the already connected gh account. Off publicly.
PORTAL_LOCAL_PREVIEW=0
# Required on a deployed production-mode server: persistent base64-encoded 32-byte key.
# Generate once using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store in a secret manager and back it up separately from the database.
PORTAL_ENCRYPTION_KEY=
# Optional operator whose sandbox bank connection comes from server environment.
PORTAL_OPERATOR_GITHUB_ID=
# Set to 1 only after sandbox:upgrade succeeds on the configured testnet contract.
PORTAL_OPEN_BOUNTY_ENABLED=0

# Optional judge walkthrough at /demo. Only explicitly configured, public,
# already-funded sandbox bounties are included. Never use the customer repo here.
PORTAL_JUDGE_DEMO=0
PORTAL_JUDGE_REPOSITORY=
# JSON map: bounty UUID -> prepared branch and EXACT 40-character commit SHA.
PORTAL_JUDGE_BOUNTIES={}
PORTAL_JUDGE_PROOF_BOUNTY_ID=
# Off by default. Enables owner-authorized squash merge ONLY of those exact
# prepared commits after successful immutable acceptance checks. Sandbox only.
PORTAL_JUDGE_AUTO_MERGE=0
# Optional: approve first-time contributor CI ONLY for those prepared commits,
# the assigned author/fork, exact PR association, and pinned acceptance workflow.
PORTAL_JUDGE_APPROVE_WORKFLOWS=0
# Optional sandbox recipient; stored only after the signed-in judge clicks consent.
PORTAL_JUDGE_PAYOUT_IBAN=
PORTAL_JUDGE_PAYOUT_FIRST_NAME=
PORTAL_JUDGE_PAYOUT_LAST_NAME=
PORTAL_JUDGE_PAYOUT_COUNTRY=
